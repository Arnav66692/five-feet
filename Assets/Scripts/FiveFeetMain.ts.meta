  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">FiveFeetMain – Zone 0 overlay orchestrator</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">References</span>"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input AssignableType_1 verdictCard {"hint":"The single floating verdict card"}'
    - '// @input AssignableType_2 zoneRing {"hint":"The Zone 0 ring on the ground"}'
    - '// @input SceneObject itemsRoot {"hint":"Parent of the pinchable items. Every child with a FiveFeetItem is wired automatically"}'
    - '// @input AssignableType_3 emberOpener {"hint":"Ember opener played before the line draws (optional: without it the line draws at start)"}'
    - "// @input AssignableType_4 progress {\"hint\":\"Progress panel on the wall: 'Zone 0: N of M fixed' (optional)\"}"
    - '// @input AssignableType_5 clearCard {"hint":"Card at the center of the wall shown when every item is fixed (optional)"}'
    - '// @input AssignableType_6 voice {"hint":"Reads the verdict and the action out loud when a card shows (optional)"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Settings</span>"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input bool placeAtUserStart = true {"hint":"At start, move the whole scene so the ground is under the user and the wall is straight ahead"}'
    - '// @input float userEyeHeightCm = 160 {"hint":"User eye height above the ground (cm), used to put the ground under the user at start", "widget":"slider", "min":100, "max":200, "step":1}'
    - '// @input string fallbackVerdict = "Not sure. Ask your fire agency" {"hint":"Verdict shown for an item that has no verdict"}'
    - '// @input string nothingToDoLine = "Nothing to do." {"hint":"Action line for an item with nothing to do"}'
    - '// @input string fixedReasonLine = "Done. Nothing else to do here." {"hint":"Reason line on the card of an item that is already fixed"}'
    - "// @input float badgeAngleDeg = 1.1 {\"hint\":\"Angular height (degrees) of a far-away badge's status line, kept the same at any distance\", \"widget\":\"slider\", \"min\":0.4, \"max\":3, \"step\":0.05}"
    - '// @input float badgeDistanceCm = 250 {"hint":"Farther than this along the ground (cm), an item shows only its badge and a pinch does not open the card", "widget":"slider", "min":100, "max":500, "step":5}'
    - '// @input float badgeHysteresisCm = 5 {"hint":"Band (cm) around the badge distance that stops the badge flickering when the user stands right at it", "widget":"slider", "min":0, "max":30, "step":1}'
    - '// @input vec4 clearLineColor = "{0.5,1,0.55,1}" {"hint":"Line color once every item is fixed (keep light: the display is additive)", "widget":"color"}'
    - '// @input vec4 clearFillColor = "{0.4,1,0.5,0.14}" {"hint":"Zone fill color once every item is fixed", "widget":"color"}'
    - '// @input float clearColorSec = 1 {"hint":"Seconds the line takes to turn from orange to green (brief: 1 s)", "widget":"slider", "min":0.2, "max":5, "step":0.1}'
    - '// @input float sfxVolume = 0.8 {"hint":"Volume of the card and ring sounds", "widget":"slider", "min":0, "max":1, "step":0.05}'
    - "// @input bool debugColliders {\"hint\":\"Draw every item's pinch target box as a wireframe (debug)\"}"
    - '// @ui {"widget":"group_end"}'
