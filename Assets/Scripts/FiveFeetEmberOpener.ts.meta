  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">FiveFeetEmberOpener – embers fall, combustibles glow</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">References</span>"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input Asset.RenderMesh emberMesh {"hint":"Mesh for one ember (a small sphere)"}'
    - '// @input Asset.Material emberMaterial {"hint":"Bright unlit material for the ember core (keep light: the display is additive)"}'
    - '// @input Asset.Material emberHaloMaterial {"hint":"Faint see-through material for the soft halo around each core (optional)"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Settings</span>"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input float emberCount = 20 {"hint":"How many embers fall (brief: about 20)", "widget":"slider", "min":5, "max":40, "step":1}'
    - '// @input float embersPerCombustible = 3 {"hint":"Embers that aim at each combustible item. The rest land on the ground or the plant", "widget":"slider", "min":0, "max":6, "step":1}'
    - '// @input float embersPerSafeItem = 1 {"hint":"Embers that aim at each item that is not combustible (shows that it does not catch)", "widget":"slider", "min":0, "max":3, "step":1}'
    - '// @input float startDelaySec = 0.2 {"hint":"Seconds before the first ember appears", "widget":"slider", "min":0, "max":2, "step":0.05}'
    - '// @input float spawnWindowSec = 2 {"hint":"Seconds over which the embers are released", "widget":"slider", "min":0.5, "max":4, "step":0.1}'
    - '// @input float fallSec = 1 {"hint":"Seconds one ember takes to fall from above the roof to the ground", "widget":"slider", "min":0.3, "max":3, "step":0.1}'
    - '// @input float emberSizeCm = 2.5 {"hint":"Diameter (cm) of the bright core of an ember (brief: 2 to 3 cm)", "widget":"slider", "min":1, "max":8, "step":0.5}'
    - '// @input float haloSizeCm = 8 {"hint":"Diameter (cm) of the faint halo around the core", "widget":"slider", "min":2, "max":20, "step":0.5}'
    - '// @input float windDriftCm = 30 {"hint":"How far (cm) the wind carries an ember sideways while it falls", "widget":"slider", "min":0, "max":80, "step":1}'
    - '// @input float glowSec = 1.5 {"hint":"Seconds a combustible item glows after an ember lands on it (brief: about 1.5 s)", "widget":"slider", "min":0.5, "max":4, "step":0.1}'
    - '// @input float seed = 7 {"hint":"Seed for the landing pattern, so every run looks the same"}'
    - '// @ui {"widget":"group_end"}'
