  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">FiveFeetVerdictCardUI – floating verdict card</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Settings</span>"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input float cardWidthCm = 25 {"hint":"Card width in cm (brief default 25 cm)", "widget":"slider", "min":15, "max":40, "step":0.5}'
    - '// @input float paddingCm = 1.5 {"hint":"Inner padding of the card in cm", "widget":"slider", "min":0.5, "max":4, "step":0.1}'
    - '// @input float rowGapCm = 0.6 {"hint":"Gap between the verdict, reason and footer rows in cm", "widget":"slider", "min":0, "max":3, "step":0.1}'
    - '// @input float readingDistanceCm = 140 {"hint":"Distance (cm) the text is sized for. The card is read from about 1.2 to 1.7 m away", "widget":"slider", "min":80, "max":250, "step":5}'
    - '// @input float autoHideSeconds = 8 {"hint":"Seconds before the card hides itself after it is shown (brief default 8 s)", "widget":"slider", "min":2, "max":30, "step":0.5}'
    - '// @input string footerLine = "State rule. Check your local fire agency." {"hint":"Footer line shown on every card"}'
    - '// @input vec4 reasonColor = "{1,1,1,0.95}" {"hint":"Reason text color (keep light: the display is additive)", "widget":"color"}'
    - '// @input vec4 footerColor = "{1,1,1,0.7}" {"hint":"Footer text color (keep light: the display is additive)", "widget":"color"}'
    - '// @input vec4 actionColor = "{1,0.9,0.6,1}" {"hint":"Action line color (keep light: the display is additive)", "widget":"color"}'
    - '// @input float doneButtonWidthCm = 14 {"hint":"Done button width in cm at scale 1 (brief: at least 8 cm)", "widget":"slider", "min":8, "max":22, "step":0.5}'
    - '// @input float doneButtonHeightCm = 5 {"hint":"Done button height in cm at scale 1", "widget":"slider", "min":3, "max":8, "step":0.25}'
    - '// @input string doneLabel = "Done" {"hint":"Label on the Done button"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Distance scaling</span>"}'
    - '// @ui {"widget":"group_start", "label":"Distance scaling"}'
    - "// @input bool scaleWithDistance = true {\"hint\":\"Grow the card with the user's distance so the verdict keeps the same apparent size\"}"
    - '// @input float verdictHeightAtReferenceCm = 3 {"hint":"Verdict text height (cm) when the user is at the reference distance (brief: about 3 cm at 1 m)", "widget":"slider", "min":1, "max":6, "step":0.1}'
    - '// @input float referenceDistanceCm = 100 {"hint":"Reference distance (cm) for the verdict height above", "widget":"slider", "min":50, "max":200, "step":5}'
    - '// @input float minScaleDistanceCm = 70 {"hint":"Closer than this (cm) the card stops shrinking", "widget":"slider", "min":30, "max":150, "step":5}'
    - '// @input float maxScaleDistanceCm = 400 {"hint":"Farther than this (cm) the card stops growing", "widget":"slider", "min":200, "max":800, "step":10}'
    - '// @ui {"widget":"group_end"}'
