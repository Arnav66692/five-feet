    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Settings</span>"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input float outerEdgeDistanceCm = 152 {"hint":"Distance (cm) from the wall face to the OUTER edge of the line. Zone 0 is 5 ft = 152 cm", "widget":"slider", "min":50, "max":300, "step":1}'
    - '// @input float lineWidthCm = 5 {"hint":"Width of the line (cm)", "widget":"slider", "min":1, "max":20, "step":0.5}'
    - '// @input float runWidthCm = 400 {"hint":"Length of the zone along the wall (cm). Matches the wall width", "widget":"slider", "min":50, "max":1000, "step":10}'
    - '// @input float lineThicknessCm = 0.6 {"hint":"Line thickness above the ground (cm)", "widget":"slider", "min":0.1, "max":3, "step":0.1}'
    - '// @input bool showSideLegs = true {"hint":"Draw the legs from the wall out to the line so the zone reads as a boundary"}'
    - '// @input float drawDurationSec = 2 {"hint":"Seconds the line takes to draw itself end to end (brief default 2 s)", "widget":"slider", "min":0.2, "max":10, "step":0.1}'
    - '// @input float fillFadeSec = 0.8 {"hint":"Seconds for the faint fill to fade in after the line is drawn", "widget":"slider", "min":0, "max":5, "step":0.1}'
