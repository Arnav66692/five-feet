  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">FiveFeetZoneRing – Zone 0 line, 5 ft from the wall</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">References</span>"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input SceneObject houseWall {"hint":"House wall root. Its origin is on the wall face and its +Z points away from the wall"}'
    - '// @input SceneObject outerLine {"hint":"Line parallel to the wall at the rule distance"}'
    - '// @input SceneObject sideLeft {"hint":"Left leg from the wall out to the outer line"}'
    - '// @input SceneObject sideRight {"hint":"Right leg from the outer line back to the wall"}'
    - '// @input SceneObject fill {"hint":"Faint fill marking the zone"}'
    - '// @ui {"widget":"group_end"}'
